# Databricks targets for scripts/deploy.sh (IDs, not secrets - auth comes from `databricks auth login`)
DATABRICKS_PROFILE=DEFAULT
CATALOG=workspace
SCHEMA=vda_dq
WAREHOUSE_ID=<your-warehouse-id>
GENIE_SPACE_ID=<your-genie-space-id>
APP_NAME=vda-dq-cockpit
# shared workspace folder for notebook + app source
WORKSPACE_DIR=/Workspace/Users/<your-email>/vda_dq
